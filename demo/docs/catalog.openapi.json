{
  "openapi": "3.1.0",
  "info": {
    "title": "Catalog API",
    "description": "Каталог товаров, брендов и категорий.",
    "version": "v1+v2"
  },
  "servers": [
    {
      "url": "http://localhost:28181",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Товары",
      "description": "Товары каталога"
    },
    {
      "name": "Категории",
      "description": "Справочник категорий"
    },
    {
      "name": "Товары v2",
      "description": "Товары каталога с пагинацией"
    },
    {
      "name": "Бренды",
      "description": "Справочник брендов"
    }
  ],
